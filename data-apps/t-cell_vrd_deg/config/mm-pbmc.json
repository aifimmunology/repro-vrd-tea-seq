{
    "dashboard": {
        "institute_homepage": "https://alleninstitute.org/division/immunology",
        "project_homepage": "https://support.allenimmunology.org/aifi/insights/ndmm",

        "project_title": "Multiple Myeloma - Peripheral Blood",
        "help_page_content": "assets/markdown/help_page.md",
        "favicon": "images/aifi_logo.png",

        "stylesheets": [
            "https://storage.googleapis.com/aifi-static-assets/hise-style.css",
            "https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css",
            "assets/css/dbc.min.css",
            "assets/css/sidebar.css",
            "assets/css/markdown.css",
            "assets/css/startup_modal.css",
            "assets/css/layout.css"
        ],

        "schema": "tests/schema.json",

        "startup_modal": true,
        "startup_modal_content": "assets/markdown/startup_modal.md",

        "gene_panel": true

    },

    "experiment": {
        "covariates": ["Comparison Type", "Foreground", "Background", "Cell Type"],
        "perturbation": false,
        "control": "PBS"
    },

    "data": {

        "deg": {
            "specifications": {
                "data_type": "deg",
                "file_type": "parquet",

                "ma_plot": true,
                "deg_by_covariates": true,
                "summaries_plot": false, 

                "p_col": "padj",
                "es_col": "log2fc",
                "means_col": "means",
                "store": "volcano-deg-df"
            },
            "files": {
                "adjp": "deg_pipeline_pbmc/results/deg/adjp.parquet",
                "log2fc": "deg_pipeline_pbmc/results/deg/log2fc.parquet",
                "meta": "deg_pipeline_pbmc/results/deg/meta.parquet",
                "summaries": "deg_pipeline_pbmc/results/deg/summaries.parquet",
                "means": "deg_pipeline_pbmc/results/deg/means.parquet",
                "t_adjp": "deg_pipeline_pbmc/results/deg/t-adjp.parquet",
                "t_log2fc": "deg_pipeline_pbmc/results/deg/t-log2fc.parquet"
            }
        },

        "gsea": {

            "specifications": {
                "store": "volcano-gsea-df-store",
                "log10_p_cutoff": 1.3,
                "es_cutoff": 0
            },

            "Hallmark": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "NES"
                },
                "files": {
                    "log_results": "deg_pipeline_pbmc/results/gsea/hallmark_log.parquet",
                    "wald_results": "deg_pipeline_pbmc/results/gsea/hallmark_wald.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsea/hallmark_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsea/hallmark_summary.parquet"
                }
            },

            "Reactome": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "NES"
                },
                "files": {
                    "log_results": "deg_pipeline_pbmc/results/gsea/reactome_log.parquet",
                    "wald_results": "deg_pipeline_pbmc/results/gsea/reactome_wald.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsea/reactome_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsea/reactome_summary.parquet"
                }
            },

            "KEGG": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "NES"
                },
                "files": {
                    "log_results": "deg_pipeline_pbmc/results/gsea/kegg_log.parquet",
                    "wald_results": "deg_pipeline_pbmc/results/gsea/kegg_wald.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsea/kegg_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsea/kegg_summary.parquet"
                }
            },

            "ChipX": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "NES"
                },
                "files": {
                    "log_results": "deg_pipeline_pbmc/results/gsea/chipx_log.parquet",
                    "wald_results": "deg_pipeline_pbmc/results/gsea/chipx_wald.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsea/chipx_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsea/chipx_summary.parquet"
                }
            }
        },

        "gsva": {

            "specifications": {
                "store": "gsva-stat-df-store",
                "log10_p_cutoff": 1.3,
                "es_cutoff": 0
            },

            "Hallmark": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "logFC"
                },
                "files": {
                    "results": "deg_pipeline_pbmc/results/gsva_stats/hallmark.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsva_stats/hallmark_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsva_stats/hallmark_summary.parquet"
                }
            },

            "Reactome": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "logFC"
                },
                "files": {
                    "results": "deg_pipeline_pbmc/results/gsva_stats/reactome.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsva_stats/reactome_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsva_stats/reactome_summary.parquet"
                }
            },

            "KEGG": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "logFC"
                },
                "files": {
                    "results": "deg_pipeline_pbmc/results/gsva_stats/kegg.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsva_stats/kegg_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsva_stats/kegg_summary.parquet"
                }
            },

            "ChipX": {
                "specifications": {
                    "file_type": "parquet",
                    "p_col": "adjP",
                    "es_col": "logFC"
                },
                "files": {
                    "results": "deg_pipeline_pbmc/results/gsva_stats/chipx.parquet",
                    "meta": "deg_pipeline_pbmc/results/gsva_stats/chipx_meta.parquet",
                    "summaries": "deg_pipeline_pbmc/results/gsva_stats/chipx_summary.parquet"
                }
            }
        },

        "gsva_scores": {
            "specifications": {
                "data_type": "pseudobulk",
                "file_type": "parquet",
                "bulk_label": "Sample",
                "store": "gsva-score-df-store"
            },
            "files": {
                "genes": "deg_pipeline_pbmc/results/gsva_scores/gsva_pathway_meta.parquet",
                "meta": "deg_pipeline_pbmc/results/gsva_scores/gsva_sample_meta.parquet",
                "norm": "deg_pipeline_pbmc/results/gsva_scores/gsva_scores.parquet"
            }
        }
    }
}