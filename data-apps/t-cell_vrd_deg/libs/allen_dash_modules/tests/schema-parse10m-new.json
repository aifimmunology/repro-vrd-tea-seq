{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Configuration Schema",
  "type": "object",
  "required": ["dashboard", "experiment", "data"],

  "properties": {
    "dashboard": {
      "type": "object",
      "required": ["institute_homepage", "project_homepage", "project_title", "help_page", "schema", "gene_panel", "startup_modal", "startup_modal_content"],
      "properties": {
        "institute_homepage": { "type": "string", "format": "uri" },
        "project_homepage": { "type": "string", "format": "uri" },
        "project_title": { "type": "string" },
        "help_page": { "type": "string" },
        "schema": { "type": "string" },
        "gene_panel": { "type": "boolean" },
        "startup_modal": { "type": "boolean" },
        "startup_modal_title": { "type": "string" },
        "startup_modal_content": { "type": "string" }
      },
      "additionalProperties": false
    },

    "experiment": {
      "type": "object",
      "required": ["covariates"],
      "properties": {
        "covariates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "perturbation": { "type": "boolean" },
        "control": { "type": "string" }
      },
      "additionalProperties": false
    },

    "data": {
      "type": "object",
      "patternProperties": {
        "^(deg|Hallmark|Reactome|pseudobulk)$": {
          "type": "object",
          "required": ["specifications", "files"],
          "properties": {
            "specifications": {
              "type": "object",
              "required": ["data_type", "file_type"],
              "properties": {
                "data_type": {
                  "type": "string",
                  "enum": ["deg", "gsea", "pseudobulk"]
                },
                "file_type": { "type": "string", "enum": ["parquet"] },
                "p_col": { "type": "string" },
                "es_col": { "type": "string" },
                "store": { "type": "string" }
              },
              "additionalProperties": true
            },
            "files": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
